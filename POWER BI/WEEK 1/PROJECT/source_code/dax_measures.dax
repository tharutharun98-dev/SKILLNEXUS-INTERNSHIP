// =====================================================================
//  Week 1 – DAX: calculated columns, calendar table and measures
//  Project : Sales Dashboard  |  Author : Tharuna B S
//
//  Paste each block into  Modeling -> New column / New measure / New table.
//  Model relationships (Model view) required first:
//      Products[ProductID]  1 ──► *  Sales[ProductID]
//      Customers[CustomerID] 1 ──► *  Sales[CustomerID]
//      DimDate[Date]        1 ──► *  Sales[OrderDate]
//  All relationships: single direction, filter flows from dimension to fact.
// =====================================================================


// ---------------------------------------------------------------------
//  1. CALCULATED COLUMNS  (table: Sales)
// ---------------------------------------------------------------------

Revenue =
Sales[Quantity] * RELATED ( Products[UnitPrice] ) * ( 1 - Sales[Discount] )

Cost =
Sales[Quantity] * RELATED ( Products[UnitCost] )

Profit =
Sales[Revenue] - Sales[Cost]


// ---------------------------------------------------------------------
//  2. CALENDAR TABLE  (Modeling -> New table)
//     Then: Table tools -> Mark as date table -> column [Date]
// ---------------------------------------------------------------------

DimDate =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2026, 12, 31 ) ),
    "Year",        YEAR ( [Date] ),
    "Quarter",     "Q" & QUARTER ( [Date] ),
    "MonthNumber", MONTH ( [Date] ),
    "Month",       FORMAT ( [Date], "MMM" ),
    "Month Year",  FORMAT ( [Date], "MMM yyyy" )
)
// Tip: select the [Month] column -> Column tools -> Sort by column -> [MonthNumber]


// ---------------------------------------------------------------------
//  3. CORE MEASURES  (create a blank table "_Measures" to keep them together)
// ---------------------------------------------------------------------

Total Revenue =
SUM ( Sales[Revenue] )

Total Cost =
SUM ( Sales[Cost] )

Total Profit =
[Total Revenue] - [Total Cost]

Profit Margin % =
DIVIDE ( [Total Profit], [Total Revenue] )

Total Orders =
DISTINCTCOUNT ( Sales[OrderID] )

Units Sold =
SUM ( Sales[Quantity] )

Avg Order Value =
DIVIDE ( [Total Revenue], [Total Orders] )


// ---------------------------------------------------------------------
//  4. MEASURES FOR THE REQUIRED VISUALS
// ---------------------------------------------------------------------

// Sales by Region  ->  Clustered column chart: Axis = Customers[Region], Values = [Total Revenue]
Revenue % of Total =
DIVIDE (
    [Total Revenue],
    CALCULATE ( [Total Revenue], ALL ( Customers[Region] ) )
)

// Top 5 Products by Profit  ->  Bar chart: Axis = Products[ProductName], Values = [Total Profit]
//   Then, in the Filters pane: ProductName -> Filter type "Top N" -> Top 5 -> By value [Total Profit]
Product Profit Rank =
RANKX ( ALL ( Products[ProductName] ), [Total Profit], , DESC, DENSE )

// Card / subtitle helper
Top Region =
VAR TopRow =
    TOPN ( 1, ALL ( Customers[Region] ), [Total Revenue], DESC )
RETURN
    MAXX ( TopRow, Customers[Region] )


// ---------------------------------------------------------------------
//  5. TIME INTELLIGENCE (bonus)
// ---------------------------------------------------------------------

Revenue YTD =
TOTALYTD ( [Total Revenue], DimDate[Date] )

Revenue PY =
CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( DimDate[Date] ) )

Revenue YoY % =
DIVIDE ( [Total Revenue] - [Revenue PY], [Revenue PY] )
